# ── WattWay · Team Kothimbir 🌿 — server environment ─────────────────────────
# Copy to `.env` and fill in. Never commit the real `.env`.

NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# MongoDB — local or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/wattway

# Redis — used by the realtime/queue module. Optional in development.
REDIS_URL=redis://127.0.0.1:6379

# JWT — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# bcrypt cost factor
BCRYPT_ROUNDS=10

# Station index (BST + Trie) — rebuild cadence in milliseconds. 0 disables it.
INDEX_REFRESH_MS=300000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
